{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug rvsim",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/rvsim",
      "args": ["${input:program}"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "make debug",
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ],
  "inputs": [
    { "id": "program", "type": "promptString",
      "description": "Πρόγραμμα RISC-V για τον simulator", "default": "tests/asm/t1_addi.bin" }
  ]
}
