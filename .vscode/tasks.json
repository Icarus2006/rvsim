{
  "version": "2.0.0",
  "tasks": [
    { "label": "make", "type": "shell", "command": "make",
      "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$gcc"] },
    { "label": "make test", "type": "shell", "command": "make test",
      "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$gcc"] },
    { "label": "make debug", "type": "shell", "command": "make debug", "problemMatcher": ["$gcc"] },
    { "label": "run riscv-tests", "type": "shell", "command": "./run_tests.sh",
      "dependsOn": "make", "problemMatcher": [] },
    { "label": "assemble current .s", "type": "shell",
      "command": "riscv64-unknown-elf-gcc -march=rv32i -mabi=ilp32 -nostdlib -Ttext=0x80000000 ${file} -o ${fileDirname}/${fileBasenameNoExtension}.elf && riscv64-unknown-elf-objcopy -O binary ${fileDirname}/${fileBasenameNoExtension}.elf ${fileDirname}/${fileBasenameNoExtension}.bin && riscv64-unknown-elf-objdump -d ${fileDirname}/${fileBasenameNoExtension}.elf",
      "problemMatcher": [] }
  ]
}
