{
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.compilerPath": "/usr/bin/gcc",
  "C_Cpp.default.includePath": ["${workspaceFolder}/src"],
  "files.associations": { "*.s": "riscv", "*.S": "riscv", "*.ld": "linkerscript" },
  "[makefile]": { "editor.insertSpaces": false, "editor.detectIndentation": false },
  "[c]": { "editor.tabSize": 4, "editor.insertSpaces": true },
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": { "build": true },
  "editor.renderWhitespace": "boundary"
}
